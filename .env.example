# ==============================================================================
# Citus Distributed PostgreSQL Cluster Environment Configuration
# ==============================================================================

# Citus & PostgreSQL pinned versions
# Primary Image: Citus 14.2.0 on PostgreSQL 16.14
CITUS_IMAGE=citusdata/citus:14.2.0-pg16
CITUS_VERSION=14.2.0
POSTGRES_VERSION=16

# Superuser credentials
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=postgres

# Host exposed ports
COORDINATOR_PORT=5432
WORKER1_PORT=5433
WORKER2_PORT=5434
WORKER3_PORT=5435
PGBOUNCER_PORT=6432

# Project name for Docker Compose network/container prefix
COMPOSE_PROJECT_NAME=citus_lab
